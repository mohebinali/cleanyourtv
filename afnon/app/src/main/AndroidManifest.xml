<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- No permissions at all: the prayer times are worked out on the TV, the card is an accessibility overlay, and
         the TV is woken for AirPlay through WakeActivity's turnScreenOn. No network, no microphone; the release build
         fails any APK that asks for RECORD_AUDIO. -->

    <!-- Android 11+ package visibility, for HomeTakeover. -->
    <queries>
        <!-- The normal home, which Home is kept on. -->
        <package android:name="com.gathin.tvhome" />
        <!-- Which launcher the HOME key reaches, and that launcher's home screens. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_arch"
        android:supportsRtl="true"
        android:allowBackup="false">

        <!-- Home, so that the app can hold the Home role HomeTakeover needs; it goes straight on to the normal home. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The adb test hook (the extra test=adhan, README) counts only when Home is started through this alias,
             tv.afnon.home/.Test. Only a holder of WRITE_SECURE_SETTINGS, the adb shell, can start it, and with no
             intent-filter it adds nothing to what HOME resolves to. It must come after MainActivity, its target. -->
        <activity-alias
            android:name=".Test"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />

        <!-- Opened once at boot by HomeTakeover when the window list can't be read, and closed at once, so whatever is
             behind it sends a window event. -->
        <activity
            android:name=".ProbeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Opened by AirPlayReturn when a phone's AirPlay comes in under the screensaver or in standby: Android wakes
             the screen for it (turnScreenOn, as for an alarm clock) and it closes at once, leaving the receiver. -->
        <activity
            android:name=".WakeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            tools:targetApi="27" />

        <!-- The always-on service: the prayer card, Home over the stock launcher, and AirPlay. Turned on with:
             settings put secure enabled_accessibility_services tv.afnon.home/.RemoteKeys -->
        <service
            android:name=".RemoteKeys"
            android:label="@string/remote_keys"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_keys" />
        </service>
    </application>
</manifest>
