<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="@drawable/input_row_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:tint="@drawable/pill_text"
        android:duplicateParentState="true"
        android:contentDescription="@null" />

    <!-- On the left, beside the icon, even for a name in a right-to-left script (the Language menu's العربية), which
         would otherwise sit at the row's far end: the app leaves RTL support off, so textDirection can't do it. -->
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="12dp"
        android:textColor="@drawable/pill_text"
        android:duplicateParentState="true"
        android:textSize="15sp"
        android:fontFamily="@string/font_medium"
        android:gravity="left"
        android:singleLine="true" />

    <View
        android:id="@+id/dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/status_dot" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@drawable/pill_text_dim"
        android:duplicateParentState="true"
        android:textSize="11sp"
        android:fontFamily="@string/font_body"
        android:letterSpacing="0.04" />
</LinearLayout>
